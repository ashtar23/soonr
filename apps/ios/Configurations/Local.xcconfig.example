// Copy to Local.xcconfig (gitignored) for values that must not be committed,
// following the same convention as apps/mobile/.env.example.
//
// The Supabase publishable key is public by design, but this repository keeps
// key material out of git. Take the value from apps/mobile/.env.development.

SOONR_SUPABASE_PUBLISHABLE_KEY =

// Optional: point Debug builds at a local API.
// SOONR_API_HOST = 127.0.0.1:3001
