// Local development. Points at staging, and the Xcode scheme can override the
// API with the SOONR_API_BASE_URL environment variable.

#include "Base.xcconfig"

SOONR_API_HOST = soonr-staging.up.railway.app
SOONR_SUPABASE_HOST = ipgvxeutodkdxmdukkym.supabase.co

// The project never defined DEBUG, so `#if DEBUG` code was compiled out of
// every configuration, including the scheme's API override.
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEBUG
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) DEBUG=1
