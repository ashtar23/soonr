# Soonr API — Coolify deploy image.
# The API runs TypeScript directly via tsx (no build step). Monorepo-aware:
# installs the whole pnpm workspace so `@repo/types` resolves via workspace symlink.
FROM node:24-slim

# corepack activates the pnpm version pinned in package.json (packageManager: pnpm@11.8.0)
RUN corepack enable

WORKDIR /app

# Copy the whole monorepo (Coolify builds from a clean git checkout, so no local node_modules)
COPY . .

# Install all workspace deps (frozen to the lockfile for reproducible builds)
RUN pnpm install --frozen-lockfile

# Runtime config — Coolify injects the rest (DATABASE_URL, SUPABASE_*, etc.) as env vars
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3001

EXPOSE 3001

# Start only the api workspace (-> tsx src/server.ts)
CMD ["pnpm", "--filter", "api", "start"]
